{
  "name": "drkyana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "skills:bundle": "node scripts/bundle-skills.mjs",
    "prebuild": "npm run skills:bundle",
    "pretypecheck": "npm run skills:bundle",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cf:build": "node scripts/migrate.mjs && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "locales:check": "python3 scripts/locales.py check",
    "images:optimize": "python3 scripts/optimize_images.py",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate:remote": "node scripts/migrate.mjs --remote --force",
    "check:isolation": "node scripts/check-isolation.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.194",
    "@drkyana/types": "*",
    "@drkyana/ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
