{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drkyana-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Provision with your CF account, then paste the IDs:
  //   npx wrangler d1 create drkyana
  //   npx wrangler kv namespace create drkyana-kv
  //   npx wrangler vectorize create drkyana-kb --dimensions=1024 --metric=cosine
  //   npx wrangler r2 bucket create drkyana-media
  "d1_databases": [
    { "binding": "DB", "database_name": "drkyana", "database_id": "d7825979-7ab9-4cc3-8e97-5ba1e31eb686" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "cfe12f92e1ad489297da35c1b9cae74a" }
  ],
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "drkyana-kb" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "drkyana-media" }
  ],
  // Workers AI — embeddings for kb_search (@cf/baai/bge-m3, 1024-dim → matches
  // the drkyana-kb Vectorize index). No id to paste; enable Workers AI on the
  // account in the CF dashboard.
  "ai": { "binding": "AI" },
  // Cloudflare Email Service — sends as receptionist@drkyana.com (cf-bounce subdomain).
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "vars": {
    "RECEPTIONIST_FROM": "receptionist@drkyana.com",
    "DR_KYANA_NOTIFY_EMAIL": "kyanalotfi96@gmail.com"
  },
  // Scheduled reminders/follow-ups (UTC). 03:00 UTC = 09:00 Dhaka.
  // NOTE: the OpenNext-generated worker (.open-next/worker.js) exports only a
  // `fetch` handler — there is no supported way to add a `scheduled()` export to
  // it, so this cron has nothing to invoke today. The reminder LOGIC is complete
  // (packages/server/src/scheduled/reminders.ts) and reachable via the Access-
  // gated POST /api/cron/reminders route. To fire it on schedule, run a tiny
  // separate Worker that exports `scheduled()` → runReminders(env) over the same
  // D1/EMAIL bindings, or have an external scheduler POST the route. See that
  // route handler's comment for details.
  // Cron disabled until a scheduled() host exists (see note above) — an active
  // trigger with no scheduled handler would just fail daily. Re-enable on the
  // separate cron Worker.
  "triggers": { "crons": [] }

  // Secrets (never commit): set with `wrangler secret put`:
  //   ANTHROPIC_API_KEY, PATIENT_AGENT_TOKEN, IP_HASH_SALT
  // Admin auth is enforced by Cloudflare Access in front of this Worker.
}
